RewriteEngine On

# Keep secrets, framework internals, and application files private.
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:CorianderCore|src|config|vendor|nodejs|database|backups|cache|logs)(?:/|$) - [F,L,NC]
RewriteRule ^public/(?:public_views(?:/|$)|routes\.php$) - [F,L,NC]
RewriteRule \.(?:bak(?:\.\d+)?|log|sqlite(?:3)?|db)$ - [F,L,NC]
RewriteRule ^(?:coriander|composer\.(?:json|lock|phar)|phpunit\.xml|AGENTS\.md)$ - [F,L,NC]

# Ensure the default directory index is public/index.php
DirectoryIndex public/index.php

# Disable directory listing for security
Options -Indexes

# Exclude static files (CSS, JS, images) from routing to index.php
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule \.(css|js|png|jpg|jpeg|gif|svg|webp)$ - [L]

# Only route non-existent files or directories to public/index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php [QSA,L]

# Error pages
ErrorDocument 404 /notfound
