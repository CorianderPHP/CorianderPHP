{
  "name": "coriander_nodejs",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "watch-typescript": "tsc --noEmit --watch",
    "build-typescript": "npm run check-types",
    "check-types": "node build.js --check",
    "test": "node --test tests/*.test.js",
    "watch-all": "node watch.all.js",
    "watch-ts": "node build.js --watch",
    "build-ts": "npm run check-types && node build.js",
    "watch-tw": "tailwindcss -i ../public/assets/css/input.css -o ../public/assets/css/output.css --watch=always --minify",
    "build-tw": "tailwindcss -i ../public/assets/css/input.css -o ../public/assets/css/output.css --minify && node fingerprint-css.js",
    "build-all": "npm run build-ts && npm run build-tw",
    "build-prod": "npm run check-types && node build.js --minify && npm run build-tw"
  },
  "author": "Dancuo Lohan",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "4.3.0",
    "typescript": "^5.9.3"
  }
}
